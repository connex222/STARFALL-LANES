{
  "name": "starfall-lanes",
  "version": "1.0.0",
  "description": "Starfall Lanes — a space-colony strategy game for the TV with phones as controllers.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "python3 build.py",
    "test": "node test-sim.js",
    "test:ui": "node test-ui-static.js && node test-phase4-ui.js && node test-phase5-cinematic.js",
    "test:phase4": "node test-phase4-ui.js",
    "test:phase5": "node test-phase5-cinematic.js",
    "test:phase6": "node --test test-phase6-rules.js && node --test test-phase6-simulation.js",
    "test:rules": "node --test test-phase6-rules.js",
    "test:offline": "npm run test:ui && npm run test:phase6 && npm run test:phase7 && npm run test:phase8 && node test-phase9-quality.js && npm run test:phase10 && npm run test:portraits",
    "test:phase7": "node test-phase7-onboarding.js",
    "test:phase8": "node test-phase8-accessibility.js",
    "test:phase9": "node test-phase9-quality.js && node --test test-phase9-balance.js",
    "audit:avatars": "python3 tools/audit_portraits.py",
    "test:phase10": "node --test test-phase10-quality.js",
    "test:phase10:sim": "node --test test-phase10-balance.js",
    "test:portraits": "node test-era-portraits.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.0.0",
    "@fontsource/orbitron": "^5.0.0",
    "qrcode-generator": "^2.0.4"
  },
  "license": "UNLICENSED",
  "private": true
}
